{
  "name": "tut",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:latest",
  "postCreateCommand": "sudo corepack enable && pnpm install && pnpm exec playwright install --with-deps chromium",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "Vite Dev Server",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "vitest.explorer",
        "ms-playwright.playwright"
      ]
    }
  }
}
